{
  "name": "stair-theme",
  "version": "1.2.2",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "bun install && composer install",
    "build:css": "node scripts/inject-version.js && bunx @tailwindcss/cli -i ./input.css -o ./style.css && node scripts/reset-version.js",
    "watch:css": "bunx @tailwindcss/cli -i ./input.css -o ./style.css --watch",
    "build": "bun run build:css",
    "dev": "bun run watch:css",
    "lint": "vendor/bin/phpcs . --standard=phpcs.xml",
    "format": "vendor/bin/php-cs-fixer fix . --config=.php-cs-fixer.dist.php --dry-run",
    "format:fix": "vendor/bin/php-cs-fixer fix . --config=.php-cs-fixer.dist.php",
    "check:fix": "bun run format:fix && bun run lint"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
