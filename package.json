{
  "name": "stair-theme",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "bun install && composer install",
    "build:css": "bunx @tailwindcss/cli -i ./input.css -o ./style.css",
    "watch:css": "bunx @tailwindcss/cli -i ./input.css -o ./style.css --watch",
    "build": "bun run build:css",
    "dev": "bun run watch:css",
    "format:fix": "vendor/bin/php-cs-fixer fix"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}